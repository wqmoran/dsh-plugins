root = true

[*]
end_of_line = lf
charset = utf-8
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# 前端 JS/TS/JSX/TSX 代码风格使用 Tab 缩进 (宽度 2)
[*.{js,jsx,ts,tsx}]
indent_style = tab
tab_width = 2

# Python & Rust 代码风格 (缩进 4 空格)
[*.{py,rs}]
indent_style = space
indent_size = 4

# Markdown 硬换行依赖行尾双空格，禁止裁剪
[*.md]
trim_trailing_whitespace = false
